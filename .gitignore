# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
*.pem
*.numbers

# logs & locks
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.lock
!package-lock.json
!yarn.lock
!pnpm-lock.yaml

# env files (strictly block all env files except .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Players Photos
public/players/
public/data/players_photos.json

# Python & Backend Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/downloaded_files/
backend/data/cache/
backend/data/cache/logs/
backend/venv/
backend/venv_soccerdata/
descargas_csv/
