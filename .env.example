# ─── Environment Variables ────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your Supabase credentials.
# NEVER commit .env.local to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional: Service Role Key (server-side only, never expose to browser) ────
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Backend Data Tools (Python scripts optional credentials) ──────────────────
# FOOTBALL_DATA_API_KEY=your-football-data-org-api-key
# API_FOOTBALL_KEY=your-api-football-key
